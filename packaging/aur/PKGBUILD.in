# Maintainer: LightZirconite <mgartner@gmail.com>
#
# This file is a template. `packaging/aur/render.sh` fills in @VERSION@ and the
# two checksums from a published release, and the Release workflow pushes the
# result to the AUR. Do not edit the rendered PKGBUILD in the AUR repository:
# the next release overwrites it.

pkgname=instacache-bin
_appname=instacache
pkgver=@VERSION@
pkgrel=1
pkgdesc="Ultra-light native Instagram desktop client, with a persistent cache and desktop notifications"
arch=('x86_64' 'aarch64')
url="https://github.com/LightZirconite/instaCache"
license=('AGPL-3.0-or-later')

# The binary is dynamically linked against the distribution's Qt on purpose;
# see "Non-negotiables" in AGENTS.md. Nothing here is vendored.
depends=('qt6-base' 'qt6-declarative' 'qt6-webengine' 'hicolor-icon-theme')
optdepends=(
  'libcanberra: sounds for notifications and for an incoming call'
  'sound-theme-freedesktop: the sounds themselves'
  'libappindicator-gtk3: tray icon on desktops without native StatusNotifier support'
)
provides=("${_appname}=${pkgver}")
conflicts=("${_appname}" "${_appname}-git")

# instaCache updates itself when it was installed by `install.sh`. A package
# does not carry `update.sh`, which is exactly how `updates::is_package_managed`
# recognises this build and leaves updating to pacman.
options=('!strip' '!debug')

source_x86_64=("${_appname}-${pkgver}-x86_64.tar.gz::${url}/releases/download/v${pkgver}/${_appname}-${pkgver}-linux-x86_64.tar.gz")
source_aarch64=("${_appname}-${pkgver}-aarch64.tar.gz::${url}/releases/download/v${pkgver}/${_appname}-${pkgver}-linux-aarch64.tar.gz")
sha256sums_x86_64=('@SHA256_X86_64@')
sha256sums_aarch64=('@SHA256_AARCH64@')

package() {
  cd "${srcdir}/${_appname}-${pkgver}-linux-${CARCH}"

  install -Dm755 "${_appname}" "${pkgdir}/usr/bin/${_appname}"
  install -Dm644 "${_appname}.desktop" \
    "${pkgdir}/usr/share/applications/${_appname}.desktop"
  install -Dm644 "assets/${_appname}.svg" \
    "${pkgdir}/usr/share/icons/hicolor/scalable/apps/${_appname}.svg"
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
  install -Dm644 CHANGELOG.md "${pkgdir}/usr/share/doc/${pkgname}/CHANGELOG.md"
}
