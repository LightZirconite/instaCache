# Maintainer: LightZirconite <nevinmelvi619@gmail.com>
#
# Arch Linux / CachyOS / Manjaro / EndeavourOS package.
#
# Build and install locally:
#     cd packaging && makepkg -si
#
# After tagging a new release, refresh the checksum with:
#     updpkgsums

pkgname=instacache
pkgver=1.0.0
pkgrel=1
pkgdesc="Native, ultra-light Instagram desktop client with a persistent cache"
arch=('x86_64' 'aarch64')
url="https://git.justw.tf/LightZirconite/instaCache"
license=('MIT')
depends=('webkit2gtk-4.1' 'gtk3' 'glib2' 'libsoup3'
         # WebKit plays video through GStreamer. gst-plugins-good carries the
         # MP4 demuxer, the HTTP source and the audio sink; gst-libav carries
         # the H.264 decoder. Without them every Instagram video stays blank
         # while images load normally.
         'gst-plugins-base' 'gst-plugins-good' 'gst-libav')
makedepends=('cargo' 'pkgconf')
optdepends=('gst-plugins-bad: extra media formats'
            'librsvg: generate raster icons at install time')
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
# Run `updpkgsums` after tagging a release to pin the real checksum before
# submitting to the AUR; SKIP is only acceptable for local builds.
sha256sums=('SKIP')

# Gitea unpacks its tag archives into a lowercased directory named after the
# repository, which is not the same as the repository's display name.
_srcdir="instacache"

prepare() {
    cd "$_srcdir"
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    cd "$_srcdir"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo build --frozen --release
}

check() {
    cd "$_srcdir"
    export RUSTUP_TOOLCHAIN=stable
    cargo test --frozen --release --lib --bins
}

package() {
    cd "$_srcdir"

    install -Dm755 "target/release/$pkgname" "$pkgdir/usr/bin/$pkgname"
    install -Dm644 "$pkgname.desktop" "$pkgdir/usr/share/applications/$pkgname.desktop"
    install -Dm644 "assets/$pkgname.svg" \
        "$pkgdir/usr/share/icons/hicolor/scalable/apps/$pkgname.svg"
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
